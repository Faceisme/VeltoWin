<Window x:Class="Velto.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Velto.UI"
        Title="Velto 设置"
        Width="980" Height="660"
        MinWidth="840" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        Background="#F4F6F8"
        Closing="OnWindowClosing">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FDFEFF"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D7DEE8"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#667085"/>

        <Style TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#B42318"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F9FAFB" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="18,16,18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="鼠标手势" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="选择一个手势进行编辑" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="新建" Click="OnAddGesture"/>
                    </Grid>

                    <Border DockPanel.Dock="Bottom" Padding="18,12" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,1,0,0" Background="#F4F6F8">
                        <UniformGrid Columns="2">
                            <Button Content="导入..." Margin="0,0,6,0" Click="OnImport"/>
                            <Button Content="导出..." Margin="6,0,0,0" Click="OnExport"/>
                        </UniformGrid>
                    </Border>

                    <ListBox x:Name="GestureList"
                             Margin="12,0,12,12"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionChanged="OnGestureSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Text="{Binding ShortcutDisplay}" Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="#F4F6F8">
                <StackPanel Margin="24,20,24,24" x:Name="DetailRoot">

                    <Border x:Name="DetailPanel" Background="{StaticResource PanelBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                            Padding="20" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NameBox" Grid.Column="0" FontSize="18" FontWeight="SemiBold"
                                         TextChanged="OnNameChanged"/>
                                <Button Grid.Column="1" Content="删除手势" Margin="12,0,0,0"
                                        Style="{StaticResource DangerButtonStyle}" Click="OnDeleteGesture"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="快捷键" Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center"/>
                                <ui:ShortcutRecorderBox x:Name="ShortcutBox" Grid.Column="1" HorizontalAlignment="Stretch"/>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,22,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="手势样本" FontWeight="SemiBold"/>
                                    <TextBlock Text="在画布上按住左键拖动,可录入多个样本" Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="清空样本" Click="OnClearSamples"/>
                            </Grid>

                            <StackPanel Grid.Row="3">
                                <ui:GestureSampleCanvas x:Name="SampleCanvas" Height="220"/>
                                <TextBlock x:Name="SampleCount" Text="0 个样本" Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Right" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="EmptyHint" Background="{StaticResource PanelBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Padding="20"
                            Visibility="Visible">
                        <TextBlock Text="选择左侧的手势,或点击「新建」创建一个。" Foreground="{StaticResource MutedTextBrush}"/>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                            Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="通用" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>

                            <CheckBox x:Name="EnabledCheck" Content="启用鼠标手势"
                                      Checked="OnPrefsChanged" Unchecked="OnPrefsChanged"/>
                            <CheckBox x:Name="TrailCheck" Content="绘制时显示轨迹反馈"
                                      Checked="OnPrefsChanged" Unchecked="OnPrefsChanged"/>
                            <CheckBox x:Name="AutoStartCheck" Content="开机自动启动 Velto"
                                      Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
                            <CheckBox x:Name="TrayIconCheck" Content="显示托盘图标"
                                      Checked="OnTrayIconChanged" Unchecked="OnTrayIconChanged"/>

                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="识别阈值(越小越严格)" VerticalAlignment="Center"/>
                                <Slider x:Name="ThresholdSlider" Grid.Row="0" Grid.Column="1" Minimum="0.10" Maximum="0.80"
                                        TickFrequency="0.05" SmallChange="0.01" LargeChange="0.05"
                                        ValueChanged="OnThresholdChanged" Margin="12,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="ThresholdLabel" VerticalAlignment="Center"
                                           TextAlignment="Right"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="手势超时秒数" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                <Slider x:Name="TimeoutSlider" Grid.Row="1" Grid.Column="1" Minimum="0.5" Maximum="10"
                                        TickFrequency="0.5" SmallChange="0.1" LargeChange="0.5"
                                        ValueChanged="OnTimeoutChanged" Margin="12,12,12,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="TimeoutLabel" VerticalAlignment="Center"
                                           TextAlignment="Right" Margin="0,12,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="作用目标" VerticalAlignment="Center" Margin="0,14,0,0"/>
                                <ComboBox x:Name="TargetCombo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                          Margin="12,14,0,0" SelectionChanged="OnTargetChanged">
                                    <ComboBoxItem Content="光标下的窗口"/>
                                    <ComboBoxItem Content="当前活动窗口"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DirtyStatusText" Text="所有修改已保存" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="DiscardButton" Content="弃用修改" Margin="0,0,10,0" Click="OnDiscardChanges"/>
                    <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveChanges"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
